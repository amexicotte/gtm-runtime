# Copy to .env for local testing. In production these are GitHub Actions secrets.
# NEVER commit or paste real values into chat.

# --- monday CRM ---
MONDAY_API_TOKEN=
MONDAY_API_VERSION=2026-07
MONDAY_DEFAULT_OWNER_ID=100000007
# Set after schema setup creates or finds the private Agent Events board.
MONDAY_AGENT_EVENTS_BOARD_ID=
# Timezone-aware Phase 1 cutover. Blank keeps narrative effects disabled and
# prevents accidental historical backfill.
BUSINESS_EVENTS_ACTIVATED_AT=
# Timezone-aware Phase 2 lower bound. Blank refuses email history/backfill.
EMAIL_LISTENING_ACTIVATED_AT=
# Explicit consent before monday E&A bodies may be sent to OpenRouter.
EMAIL_REASONING_APPROVED=false
# Live effects require all three gates plus three distinct reviewed ET dates.
EMAIL_AUTOMATIC_WRITES_APPROVED=false
EMAIL_SHADOW_REVIEW_APPROVED=false
EMAIL_IMMEDIATE_ROLLOUT_APPROVED=false
EMAIL_SHADOW_OBSERVATION_DATES=
EMAIL_SHADOW_MIN_NIGHTS=3
EMAIL_RECONCILIATION_OVERLAP_HOURS=72
MAX_EMAIL_TIMELINE_ITEMS_PER_RUN=500
MAX_EMAIL_THREADS_PER_RUN=50
MAX_EMAIL_REASONING_PER_RUN=20
EMAIL_COMPLETION_CONFIDENCE=0.90
# Non-secret custom E&A activity ID for the isolated live-verification fixture.
# It is ignored unless --verification-contact-ids is also supplied.
EMAIL_VERIFICATION_CUSTOM_ACTIVITY_ID=
# Non-secret JSON map of SHA-256(lowercase email) to an explicitly chosen
# canonical Contact ID. Duplicate records remain untouched and read-only.
EMAIL_CONTACT_IDENTITY_RESOLUTIONS={}
NUDGE_STALLED_HOURS=36
NUDGE_UNANSWERED_HOURS=48

# --- Fireflies meeting source ---
FIREFLIES_API_KEY=
FIREFLIES_LOOKBACK_DAYS=2
# One-time production baseline; prevents the first run from backfilling history.
FIREFLIES_NOT_BEFORE=

# --- Reasoning (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Confirm the exact slug on openrouter.ai/models (DeepSeek V4-Pro is new):
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# --- Notion business context (existing workspace, read-only runtime) ---
NOTION_API_TOKEN=
NOTION_VERSION=2025-09-03

# Phase 3 stays disabled until both workspace-wide read-only providers pass audit.
BUSINESS_CONTEXT_ENABLED=false
HARBOR_WEBSITE_URL=https://harboradvisors.example/
BUSINESS_CONTEXT_MAX_TOOL_CALLS=6
BUSINESS_CONTEXT_MAX_ENTITY_IDS=20
BUSINESS_CONTEXT_MAX_UPDATES=10
BUSINESS_CONTEXT_MAX_DOC_RESULTS=5
BUSINESS_CONTEXT_MAX_EXCERPT_CHARS=4000
BUSINESS_CONTEXT_MAX_PREFETCH_CHARS=12000
BUSINESS_CONTEXT_MAX_FILE_BYTES=5000000

# --- Phase 5 advisory portfolio patterns ---
PORTFOLIO_PATTERN_ENABLED=false
PORTFOLIO_REASONING_APPROVED=false
PORTFOLIO_PATTERN_WRITES_APPROVED=false
PORTFOLIO_MAX_TERMINAL_DEALS=200
PORTFOLIO_UPDATES_PER_DEAL=10
PORTFOLIO_MIN_COHORT_SIZE=3

# --- Slack (bot token from your Harbor GTM app) ---
SLACK_BOT_TOKEN=
SLACK_CALL_NOTES_CHANNEL=call-notes
SLACK_DEAL_ALERTS_CHANNEL=deal-alerts
# Optional JSON mapping, for example {"monday-user-id":"slack-user-id"}.
SLACK_USER_IDS_BY_MONDAY_ID=
# Root posts beginning with `manual:` are scanned across this rolling window.
SLACK_MANUAL_NOTES_LOOKBACK_DAYS=14

# --- GitHub Actions usage alert (non-secret values are repository variables) ---
ACTIONS_MONTHLY_MINUTES_LIMIT=2000
ACTIONS_USAGE_ALERT_THRESHOLDS=75,90,100
SLACK_USAGE_ALERT_CHANNEL=deal-alerts
# Optional Slack user ID for a direct message instead of a channel post.
SLACK_USAGE_ALERT_USER_ID=
# Optional fine-grained token with only Plan: read for exact account usage.
GITHUB_BILLING_READ_TOKEN=

# --- Google Drive (read-only rclone remote) ---
GOOGLE_DRIVE_RCLONE_REMOTE=harbor-drive
# Separate full-scope credential; runtime exposes list/upload only and roots each
# operation to the exact Account Drive Folder ID.
GOOGLE_DRIVE_WRITER_RCLONE_REMOTE=harbor-drive-writer

# --- DocuSign completed-envelope source (JWT Grant) ---
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_AUTH_SERVER=account.docusign.com
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_ACTIVATED_AT=
DOCUSIGN_REASONING_APPROVED=false
DOCUSIGN_AUTOMATIC_WRITES_APPROVED=false
DOCUSIGN_DOCUMENT_ARCHIVE_APPROVED=false
DOCUSIGN_RECONCILIATION_OVERLAP_HOURS=168
DOCUSIGN_MAX_ENVELOPES_PER_RUN=20

# --- Guardrails ---
MAX_MEETINGS_PER_RUN=20
NOTES_FALLBACK_HOURS=12
